{
  "name": "chatgpt-ctrl-enter-sender-firefox",
  "version": "2.5.8",
  "private": true,
  "description": "Firefox extension that assigns Ctrl+Enter to send messages in ChatGPT and other AI chat sites",
  "main": "service-worker.js",
  "scripts": {
    "bump": "node tools/bump-version.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tools/*.test.js",
    "test:integration": "playwright test",
    "test:loading": "playwright test extension-loading",
    "test:live": "playwright test --config=playwright.live.config.js",
    "test:sites": "playwright test --config=playwright.live.config.js site-accessibility",
    "test:behavior": "playwright test --config=playwright.live.config.js ctrl-enter-behavior",
    "test:public": "playwright test --config=playwright.live.config.js --grep 'Public Sites'",
    "login": "node tests/login-helper.js",
    "login:all": "node tests/login-helper.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox.git"
  },
  "keywords": [],
  "author": "Kamada Masachika, Xolli",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox/issues"
  },
  "homepage": "https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}